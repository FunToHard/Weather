<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Weather.ViewModels"
        xmlns:models="using:Weather.Models"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Weather.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Weather"
        Width="1100" Height="700"
        MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="44"
        TransparencyLevelHint="AcrylicBlur, Mica, None"
        Background="Transparent">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Solid background fallback when backdrop transparency is unsupported or disabled -->
        <Style Selector="Window[ActualTransparencyLevel=None]">
            <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}" />
        </Style>
        <Style Selector="Window[ActualTransparencyLevel=None] Border#BackdropTint">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Subtle theme tint layer allowing backdrop blur to shine through with high legibility -->
        <Border x:Name="BackdropTint"
                Background="{DynamicResource SystemRegionBrush}"
                Opacity="0.25"
                IsHitTestVisible="False" />

        <Grid RowDefinitions="Auto,*">
            <!-- Extended Titlebar Area (Height 44 DIPs) -->
            <Border Grid.Row="0"
                    Height="44"
                    Background="Transparent">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Column 0: App Branding (Draggable) -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,16,0"
                                Spacing="10"
                                Background="Transparent"
                                PointerPressed="TitleBar_PointerPressed">
                        <Image Source="/Assets/avalonia-logo.ico"
                               Width="18"
                               Height="18"
                               VerticalAlignment="Center" />
                        <TextBlock Text="{Binding $parent[Window].Title}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Opacity="0.85" />
                    </StackPanel>

                    <!-- Column 1: Center Draggable Space with Search & Location -->
                    <Grid Grid.Column="1"
                          ColumnDefinitions="*,Auto,*"
                          Background="Transparent"
                          PointerPressed="TitleBar_PointerPressed">
                        <!-- Centered Search Box and Location Chip -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <TextBox Classes="GlassSearch"
                                     Width="280"
                                     Height="32"
                                     Watermark="Search city or location..."
                                     Text="{Binding SearchQuery}">
                                <TextBox.InnerLeftContent>
                                    <svg:Svg Path="/Assets/Icons/search.svg"
                                             Width="14"
                                             Height="14"
                                             Margin="10,0,4,0"
                                             Opacity="0.65" />
                                </TextBox.InnerLeftContent>
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>

                            <Border Classes="GlassPill"
                                    Padding="10,0"
                                    Height="32"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">
                                    <svg:Svg Path="/Assets/Icons/location.svg"
                                             Width="14"
                                             Height="14" />
                                    <TextBlock Text="{Binding City}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Column 2: System Caption Buttons Safe Reservation (~140 DIPs) -->
                    <Border Grid.Column="2" Width="140" Background="Transparent" />
                </Grid>
            </Border>

            <!-- Main Weather Dashboard Layout -->
            <Border Grid.Row="1"
                    Margin="20,8,20,20"
                    Padding="{Binding $parent[Window].OffScreenMargin}">
                <Grid ColumnDefinitions="290,*,290">
                    <!-- LEFT COLUMN: 7-Day Forecast -->
                    <Border Grid.Column="0"
                            Classes="GlassCard"
                            Padding="16"
                            Margin="0,0,12,0">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0"
                                       Text="7-Day Forecast"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Margin="4,0,0,12"
                                       Opacity="0.85" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DailyForecasts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DailyForecast">
                                            <Border Classes="GlassPill"
                                                    Margin="0,0,0,8"
                                                    Padding="12,10">
                                                <Grid ColumnDefinitions="36,30,*,60">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Day}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               VerticalAlignment="Center" />
                                                    <svg:Svg Grid.Column="1"
                                                             Path="{Binding IconPath}"
                                                             Width="22"
                                                             Height="22"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Center" />
                                                    <!-- Temperature Range Gradient Bar -->
                                                    <Grid Grid.Column="2"
                                                          Margin="8,0"
                                                          VerticalAlignment="Center"
                                                          Height="5">
                                                        <Border CornerRadius="2.5"
                                                                Background="#15000000" />
                                                        <Border CornerRadius="2.5"
                                                                Height="5"
                                                                HorizontalAlignment="Stretch">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                    <GradientStop Color="#60A5FA" Offset="0" />
                                                                    <GradientStop Color="#FBBF24" Offset="0.5" />
                                                                    <GradientStop Color="#F87171" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding TempRangeDisplay}"
                                                               FontSize="12"
                                                               Opacity="0.85"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Right" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- CENTER COLUMN: Current Conditions Hero & Hourly Timeline -->
                    <Grid Grid.Column="1"
                          RowDefinitions="Auto,*"
                          Margin="4,0,4,0">
                        <!-- Hero Card -->
                        <Border Grid.Row="0"
                                Classes="GlassCard"
                                Padding="26"
                                Margin="0,0,0,14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                    <TextBlock Text="{Binding CurrentTempDisplay}"
                                               FontSize="64"
                                               FontWeight="Bold"
                                               LetterSpacing="-1" />
                                    <TextBlock Text="{Binding Condition}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,4" />
                                    <TextBlock Text="{Binding TempRange}"
                                               FontSize="13"
                                               Opacity="0.75" />
                                </StackPanel>

                                <!-- Hero SVG Weather Illustration -->
                                <svg:Svg Grid.Column="1"
                                         Path="{Binding HeroIconPath}"
                                         Width="125"
                                         Height="125"
                                         Margin="12,0,0,0"
                                         VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Hourly Forecast Section -->
                        <Border Grid.Row="1"
                                Classes="GlassCard"
                                Padding="20">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0"
                                           Text="Hourly Forecast"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="4,0,0,14"
                                           Opacity="0.85" />
                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding HourlyForecasts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="10" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:HourlyForecast">
                                                <Border Classes="GlassPill"
                                                        Width="80"
                                                        Padding="8,14">
                                                    <StackPanel Spacing="10"
                                                                HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Time}"
                                                                   FontSize="12"
                                                                   Opacity="0.75"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding TempDisplay}"
                                                                   FontSize="16"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center" />
                                                        <svg:Svg Path="{Binding IconPath}"
                                                                 Width="30"
                                                                 Height="30"
                                                                 HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RIGHT COLUMN: Atmospheric Metrics (2x2 Grid) -->
                    <Grid Grid.Column="2"
                          RowDefinitions="*,*"
                          ColumnDefinitions="*,*"
                          Margin="12,0,0,0">
                        <!-- Card 1: Wind Speed -->
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Classes="GlassCard"
                                Padding="16"
                                Margin="0,0,6,6">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                    <svg:Svg Path="/Assets/Icons/wind.svg"
                                             Width="16"
                                             Height="16" />
                                    <TextBlock Text="Wind speed"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Opacity="0.75" />
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding WindSpeed}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding WindDirection}"
                                           FontSize="12"
                                           Opacity="0.7" />
                            </Grid>
                        </Border>

                        <!-- Card 2: Humidity -->
                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Classes="GlassCard"
                                Padding="16"
                                Margin="6,0,0,6">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                    <svg:Svg Path="/Assets/Icons/humidity.svg"
                                             Width="16"
                                             Height="16" />
                                    <TextBlock Text="Humidity"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Opacity="0.75" />
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Humidity}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2"
                                           Text="Normal"
                                           FontSize="12"
                                           Opacity="0.7" />
                            </Grid>
                        </Border>

                        <!-- Card 3: UV Index -->
                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Classes="GlassCard"
                                Padding="16"
                                Margin="0,6,6,0">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                    <svg:Svg Path="/Assets/Icons/uv-index.svg"
                                             Width="16"
                                             Height="16" />
                                    <TextBlock Text="UV Index"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Opacity="0.75" />
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding UvIndex}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding UvLevel}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#F59E0B" />
                            </Grid>
                        </Border>

                        <!-- Card 4: Air Quality -->
                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Classes="GlassCard"
                                Padding="16"
                                Margin="6,6,0,0">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                    <svg:Svg Path="/Assets/Icons/air-quality.svg"
                                             Width="16"
                                             Height="16" />
                                    <TextBlock Text="Air Quality"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Opacity="0.75" />
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding AirQuality}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding AirQualityStatus}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#10B981" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Panel>
</Window>
