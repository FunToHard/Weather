<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Weather.ViewModels"
        xmlns:models="using:Weather.Models"
        xmlns:controls="using:Weather.Controls"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1140" d:DesignHeight="720"
        x:Class="Weather.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Weather"
        Width="1140" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="44"
        TransparencyLevelHint="AcrylicBlur, Mica, None"
        Background="Transparent">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Solid background fallback when backdrop transparency is unsupported or disabled -->
        <Style Selector="Window[ActualTransparencyLevel=None]">
            <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}" />
        </Style>
        <Style Selector="Window[ActualTransparencyLevel=None] Border#BackdropTint">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- Smooth View Cross-Fade Transition Layer Styles -->
        <Style Selector="Border.ViewLayer">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseInOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.ViewLayer.ActiveView">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <!-- Location Badge Clickable Hover Style -->
        <Style Selector="Border.LocationBadge">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.LocationBadge:pointerover">
            <Setter Property="Background" Value="#BFDBFE" />
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Subtle theme tint layer allowing backdrop blur to shine through with high legibility -->
        <Border x:Name="BackdropTint"
                Background="{DynamicResource SystemRegionBrush}"
                Opacity="0.25"
                IsHitTestVisible="False" />

        <Grid RowDefinitions="Auto,*">
            <!-- Extended Titlebar Area (Height 44 DIPs) matching main dashboard 3-column bounds -->
            <Border Grid.Row="0"
                    Height="44"
                    Margin="20,0,20,0"
                    Background="Transparent">
                <Grid ColumnDefinitions="300,*,320">
                    <!-- Column 0: Weather Icon Branding (Draggable) -->
                    <Border Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Background="Transparent"
                            PointerPressed="TitleBar_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <svg:Svg Path="/Assets/Icons/partly-cloudy.svg"
                                     Width="24"
                                     Height="24"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Column 1: Search Bar matching Hero Card boundaries exactly -->
                    <Border Grid.Column="1"
                            Height="36"
                            CornerRadius="8"
                            Background="#32FFFFFF"
                            BorderBrush="#65FFFFFF"
                            BorderThickness="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Margin="4,0,4,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Search Icon -->
                            <svg:Svg Grid.Column="0"
                                     Path="/Assets/Icons/search.svg"
                                     Width="15"
                                     Height="15"
                                     Margin="12,0,8,0"
                                     VerticalAlignment="Center"
                                     Opacity="0.65" />

                            <!-- Transparent Text Input -->
                            <TextBox Grid.Column="1"
                                     Classes="TransparentSearch"
                                     Watermark="Search city or location..."
                                     Text="{Binding SearchQuery}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>

                            <!-- Right-nested Location Pill Badge (Press to view Location & Map) -->
                            <Border Grid.Column="2"
                                    Classes="LocationBadge"
                                    CornerRadius="6"
                                    Background="#D8E2EE"
                                    Padding="10,3"
                                    Margin="4"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    PointerPressed="LocationBadge_PointerPressed"
                                    ToolTip.Tip="Press to view Location &amp; Map">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <svg:Svg Path="/Assets/Icons/location.svg"
                                             Width="12"
                                             Height="12"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding City}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="#1E293B"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Column 2: System Caption Buttons Safe Reservation (~140 DIPs) + Drag Area -->
                    <Border Grid.Column="2"
                            Margin="12,0,0,0"
                            Background="Transparent"
                            PointerPressed="TitleBar_PointerPressed" />
                </Grid>
            </Border>

            <!-- Main Weather Dashboard Layout -->
            <Border Grid.Row="1"
                    Margin="20,6,20,20"
                    Padding="{Binding $parent[Window].OffScreenMargin}">
                <Grid ColumnDefinitions="300,*,320">
                    <!-- LEFT COLUMN: 7-Day Forecast & Sunrise/Sunset Tracker -->
                    <Grid Grid.Column="0" RowDefinitions="*,Auto" Margin="0,0,12,0">
                        <!-- 7-Day Forecast Card -->
                        <Border Grid.Row="0"
                                Classes="GlassCard"
                                Padding="16"
                                Margin="0,0,0,12">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0"
                                           Text="7-Day Forecast"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="4,0,0,12"
                                           Opacity="0.85" />
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DailyForecasts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DailyForecast">
                                                <Border Classes="GlassPill"
                                                        Margin="0,0,0,8"
                                                        Padding="12,9">
                                                    <Grid ColumnDefinitions="36,28,*,60">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Day}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center" />
                                                        <svg:Svg Grid.Column="1"
                                                                 Path="{Binding IconPath}"
                                                                 Width="22"
                                                                 Height="22"
                                                                 VerticalAlignment="Center"
                                                                 HorizontalAlignment="Center" />
                                                        <!-- Temperature Range Gradient Bar -->
                                                        <Grid Grid.Column="2"
                                                              Margin="8,0"
                                                              VerticalAlignment="Center"
                                                              Height="5">
                                                            <Border CornerRadius="2.5"
                                                                    Background="#15000000" />
                                                            <Border CornerRadius="2.5"
                                                                    Height="5"
                                                                    HorizontalAlignment="Stretch">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                        <GradientStop Color="#60A5FA" Offset="0" />
                                                                        <GradientStop Color="#FBBF24" Offset="0.5" />
                                                                        <GradientStop Color="#F87171" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding TempRangeDisplay}"
                                                                   FontSize="12"
                                                                   Opacity="0.85"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Sunrise & Sunset Solar Tracker Card -->
                        <Border Grid.Row="1"
                                Classes="GlassCard"
                                Padding="16">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="Sun &amp; Daylight"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Opacity="0.85" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DaylightStatus}"
                                               FontSize="11"
                                               Opacity="0.75" />
                                </Grid>

                                <!-- Visual Solar Arc -->
                                <svg:Svg Path="/Assets/Icons/solar-tracker.svg"
                                         Height="72"
                                         Margin="0,4,0,4"
                                         HorizontalAlignment="Center" />

                                <!-- Sunrise and Sunset Times -->
                                <Grid ColumnDefinitions="*,Auto,*">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Sunrise" FontSize="11" Opacity="0.65" />
                                        <TextBlock Text="{Binding Sunrise}" FontSize="13" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DaylightDuration}"
                                               FontSize="11"
                                               Opacity="0.7"
                                               VerticalAlignment="Bottom" />

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="Sunset" FontSize="11" Opacity="0.65" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Sunset}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- CENTER COLUMN: Current Conditions Hero & Mapsui Interactive Map -->
                    <Grid Grid.Column="1"
                          RowDefinitions="Auto,*"
                          Margin="4,0,4,0">
                        <!-- Hero Card -->
                        <Border Grid.Row="0"
                                Classes="GlassCard"
                                Padding="26"
                                Margin="0,0,0,14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Spacing="4">
                                    <TextBlock Text="{Binding CurrentTempDisplay}"
                                               FontSize="64"
                                               FontWeight="Bold"
                                               LetterSpacing="-1" />
                                    <TextBlock Text="{Binding Condition}"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,2,0,4" />
                                    <TextBlock Text="{Binding TempRange}"
                                               FontSize="13"
                                               Opacity="0.75" />
                                </StackPanel>

                                <!-- Hero SVG Weather Illustration -->
                                <svg:Svg Grid.Column="1"
                                         Path="{Binding HeroIconPath}"
                                         Width="125"
                                         Height="125"
                                         Margin="12,0,0,0"
                                         VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Dual-View Container: Cross-fades smoothly between Hourly Forecast and Location & Map -->
                        <Grid Grid.Row="1">
                            <!-- View 1: Responsive Hourly Forecast Card with Continuous Temperature Spline Graph -->
                            <Border Classes="GlassCard ViewLayer"
                                    Classes.ActiveView="{Binding IsHourlyForecastVisible}"
                                    Padding="18">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,0,12">
                                        <TextBlock Grid.Column="0"
                                                   Text="Hourly Forecast"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Opacity="0.85"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="1"
                                                Classes="GlassPill"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                PointerPressed="OpenMap_PointerPressed"
                                                ToolTip.Tip="Open Location &amp; Map">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <svg:Svg Path="/Assets/Icons/location.svg" Width="11" Height="11" Opacity="0.75" VerticalAlignment="Center" />
                                                <TextBlock Text="Map" FontSize="11" FontWeight="Medium" Opacity="0.85" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Container for Responsive Columns and Spline Graph Overlay -->
                                    <Grid Grid.Row="1">
                                        <!-- 5 Equal Width Columns (20% each) stretching with window resize -->
                                        <Grid ColumnDefinitions="*,*,*,*,*">
                                            <!-- Hour 1 -->
                                            <Border Grid.Column="0" Classes="GlassPill" Margin="4,0" Padding="6,12">
                                                <Grid RowDefinitions="Auto,Auto,*,Auto">
                                                    <TextBlock Grid.Row="0" Text="{Binding HourlyForecasts[0].Time}" FontSize="12" Opacity="0.75" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Row="1" Text="{Binding HourlyForecasts[0].TempDisplay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    <Panel Grid.Row="2" Height="36" />
                                                    <svg:Svg Grid.Row="3" Path="{Binding HourlyForecasts[0].IconPath}" Width="28" Height="28" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- Hour 2 -->
                                            <Border Grid.Column="1" Classes="GlassPill" Margin="4,0" Padding="6,12">
                                                <Grid RowDefinitions="Auto,Auto,*,Auto">
                                                    <TextBlock Grid.Row="0" Text="{Binding HourlyForecasts[1].Time}" FontSize="12" Opacity="0.75" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Row="1" Text="{Binding HourlyForecasts[1].TempDisplay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    <Panel Grid.Row="2" Height="36" />
                                                    <svg:Svg Grid.Row="3" Path="{Binding HourlyForecasts[1].IconPath}" Width="28" Height="28" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- Hour 3 -->
                                            <Border Grid.Column="2" Classes="GlassPill" Margin="4,0" Padding="6,12">
                                                <Grid RowDefinitions="Auto,Auto,*,Auto">
                                                    <TextBlock Grid.Row="0" Text="{Binding HourlyForecasts[2].Time}" FontSize="12" Opacity="0.75" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Row="1" Text="{Binding HourlyForecasts[2].TempDisplay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    <Panel Grid.Row="2" Height="36" />
                                                    <svg:Svg Grid.Row="3" Path="{Binding HourlyForecasts[2].IconPath}" Width="28" Height="28" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- Hour 4 -->
                                            <Border Grid.Column="3" Classes="GlassPill" Margin="4,0" Padding="6,12">
                                                <Grid RowDefinitions="Auto,Auto,*,Auto">
                                                    <TextBlock Grid.Row="0" Text="{Binding HourlyForecasts[3].Time}" FontSize="12" Opacity="0.75" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Row="1" Text="{Binding HourlyForecasts[3].TempDisplay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    <Panel Grid.Row="2" Height="36" />
                                                    <svg:Svg Grid.Row="3" Path="{Binding HourlyForecasts[3].IconPath}" Width="28" Height="28" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>

                                            <!-- Hour 5 -->
                                            <Border Grid.Column="4" Classes="GlassPill" Margin="4,0" Padding="6,12">
                                                <Grid RowDefinitions="Auto,Auto,*,Auto">
                                                    <TextBlock Grid.Row="0" Text="{Binding HourlyForecasts[4].Time}" FontSize="12" Opacity="0.75" HorizontalAlignment="Center" />
                                                    <TextBlock Grid.Row="1" Text="{Binding HourlyForecasts[4].TempDisplay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    <Panel Grid.Row="2" Height="36" />
                                                    <svg:Svg Grid.Row="3" Path="{Binding HourlyForecasts[4].IconPath}" Width="28" Height="28" HorizontalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Continuous Temperature Spline Graph Overlay (60% height, vivid orange/blue drop) -->
                                        <controls:TemperatureTrendGraph Height="36"
                                                                        Margin="4,46,4,38"
                                                                        Temperatures="{Binding HourlyTemps}"
                                                                        IsHitTestVisible="False"
                                                                        VerticalAlignment="Center"
                                                                        HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- View 2: Location & Map Card (Notice: "Interactive" is removed) -->
                            <Border Classes="GlassCard ViewLayer"
                                    Classes.ActiveView="{Binding IsMapVisible}"
                                    Padding="14"
                                    ClipToBounds="True">
                                <Grid RowDefinitions="Auto,*">
                                    <!-- Card Header -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="2,0,2,10">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <svg:Svg Path="/Assets/Icons/location.svg" Width="14" Height="14" Opacity="0.8" VerticalAlignment="Center" />
                                            <TextBlock Text="Location &amp; Map"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.85"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="Tap anywhere to select location"
                                                   FontSize="11"
                                                   Opacity="0.55"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                        <!-- Coordinates Badge -->
                                        <Border Grid.Column="2"
                                                Classes="GlassPill"
                                                Padding="8,3"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CoordinatesDisplay}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Opacity="0.8" />
                                        </Border>

                                        <!-- Return to Forecast Button -->
                                        <Border Grid.Column="3"
                                                Classes="GlassPill"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                PointerPressed="CloseMap_PointerPressed"
                                                ToolTip.Tip="Return to Hourly Forecast">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="Forecast" FontSize="11" FontWeight="Medium" Opacity="0.85" />
                                                <TextBlock Text="✕" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Mapsui MapControl -->
                                    <Border Grid.Row="1"
                                            CornerRadius="8"
                                            ClipToBounds="True"
                                            Background="#10000000">
                                        <mapsui:MapControl x:Name="WeatherMap"
                                                           VerticalAlignment="Stretch"
                                                           HorizontalAlignment="Stretch" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- RIGHT COLUMN: Atmospheric Metrics with Large Visual Graphic Gauges (2x3 Grid) -->
                    <Grid Grid.Column="2"
                          RowDefinitions="*,*,*"
                          ColumnDefinitions="*,*"
                          Margin="12,0,0,0">
                        <!-- Card 1: Wind Speed (Dynamic Compass Gauge) -->
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Classes="GlassCard"
                                Padding="10"
                                Margin="0,0,4,4">
                            <Grid RowDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Row="0"
                                           Text="Wind speed"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Opacity="0.8"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <!-- Dynamic Compass Gauge -->
                                <controls:CompassGauge Grid.Row="1"
                                                       Angle="{Binding WindAngle}"
                                                       Width="76"
                                                       Height="76"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,2,0,2" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding WindSpeed}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <TextBlock Grid.Row="3"
                                           Text="{Binding WindDirection}"
                                           FontSize="11"
                                           Opacity="0.7"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 2: Humidity (Dynamic Dial Gauge) -->
                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Classes="GlassCard"
                                Padding="10"
                                Margin="4,0,0,4">
                            <Grid RowDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Row="0"
                                           Text="Humidity"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Opacity="0.8"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <!-- Dynamic Circular Dial Gauge -->
                                <controls:HumidityGauge Grid.Row="1"
                                                        Value="{Binding HumidityValue}"
                                                        Width="76"
                                                        Height="76"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Margin="0,2,0,2" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Humidity}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <TextBlock Grid.Row="3"
                                           Text="Normal"
                                           FontSize="11"
                                           Opacity="0.7"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 3: UV Index (Dynamic Rainbow Arc Gauge) -->
                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Classes="GlassCard"
                                Padding="10"
                                Margin="0,4,4,4">
                            <Grid RowDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Row="0"
                                           Text="UV Index"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Opacity="0.8"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <!-- Dynamic Rainbow Arc Gauge -->
                                <controls:UvGauge Grid.Row="1"
                                                  Value="{Binding UvIndexValue}"
                                                  Width="84"
                                                  Height="66"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="0,4,0,0" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding UvIndex}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <TextBlock Grid.Row="3"
                                           Text="{Binding UvLevel}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#F59E0B"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 4: Air Quality (Dynamic Circular Progress Meter) -->
                        <Border Grid.Row="1"
                                Grid.Column="1"
                                Classes="GlassCard"
                                Padding="10"
                                Margin="4,4,0,4">
                            <Grid RowDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Row="0"
                                           Text="Air Quality"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Opacity="0.8"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <!-- Dynamic AQI Gauge -->
                                <controls:AqiGauge Grid.Row="1"
                                                   Value="{Binding AqiValue}"
                                                   Width="76"
                                                   Height="76"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,2,0,2" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding AirQuality}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <TextBlock Grid.Row="3"
                                           Text="{Binding AirQualityStatus}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#10B981"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 5: Pressure (Dynamic Barometer Gauge) -->
                        <Border Grid.Row="2"
                                Grid.Column="0"
                                Classes="GlassCard"
                                Padding="10"
                                Margin="0,4,4,0">
                            <Grid RowDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Row="0"
                                           Text="Pressure"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Opacity="0.8"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <!-- Dynamic Barometer Gauge -->
                                <controls:BarometerGauge Grid.Row="1"
                                                         Value="{Binding PressureValue}"
                                                         Width="84"
                                                         Height="66"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Margin="0,4,0,0" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Pressure}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <TextBlock Grid.Row="3"
                                           Text="{Binding PressureStatus}"
                                           FontSize="11"
                                           Opacity="0.7"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 6: Visibility (Dynamic Horizon Eye Gauge) -->
                        <Border Grid.Row="2"
                                Grid.Column="1"
                                Classes="GlassCard"
                                Padding="10"
                                Margin="4,4,0,0">
                            <Grid RowDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Row="0"
                                           Text="Visibility"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Opacity="0.8"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <!-- Dynamic Visibility Gauge -->
                                <controls:VisibilityGauge Grid.Row="1"
                                                          Value="{Binding VisibilityValue}"
                                                          Width="84"
                                                          Height="66"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="0,4,0,0" />
                                <TextBlock Grid.Row="2"
                                           Text="{Binding Visibility}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                                <TextBlock Grid.Row="3"
                                           Text="{Binding VisibilityStatus}"
                                           FontSize="11"
                                           Opacity="0.7"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Panel>
</Window>
